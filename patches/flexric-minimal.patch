diff --git a/examples/emulator/agent/sm_mac.c b/examples/emulator/agent/sm_mac.c
index cccab9c..c99c063 100644
--- a/examples/emulator/agent/sm_mac.c
+++ b/examples/emulator/agent/sm_mac.c
@@ -4,6 +4,12 @@
 #include "sm_mac.h"
 #include "../../../test/rnd/fill_rnd_data_mac.h"
 #include <assert.h>
+#include <stdatomic.h>
+
+// A control action changes synthetic radio/QoS proxy fields for the next five
+// seconds (the xApp subscribes every 10 ms). This makes closed-loop behavior
+// measurable without pretending that the emulator contains a real scheduler.
+static _Atomic uint32_t mitigation_reads = 0;
 
 void init_mac_sm(void)
 {
@@ -24,6 +30,18 @@ bool read_mac_sm(void* data)
 
   mac_ind_data_t* mac = (mac_ind_data_t*)data;
   fill_mac_ind_data(mac);
+  uint32_t remaining = atomic_load(&mitigation_reads);
+  if(remaining > 0){
+    for(uint32_t i = 0; i < mac->msg.len_ue_stats; ++i){
+      mac->msg.ue_stats[i].dl_aggr_prb = (mac->msg.ue_stats[i].dl_aggr_prb * 35) / 100;
+      uint64_t boosted_tbs = (mac->msg.ue_stats[i].dl_aggr_tbs * 140) / 100;
+      mac->msg.ue_stats[i].dl_aggr_tbs = boosted_tbs > 1023 ? 1023 : boosted_tbs;
+      mac->msg.ue_stats[i].bsr = (mac->msg.ue_stats[i].bsr * 40) / 100;
+      mac->msg.ue_stats[i].dl_aggr_retx_prb =
+          (mac->msg.ue_stats[i].dl_aggr_retx_prb * 40) / 100;
+    }
+    atomic_fetch_sub(&mitigation_reads, 1);
+  }
   return true;
 }
 
@@ -42,6 +60,7 @@ sm_ag_if_ans_t write_ctrl_mac_sm(void const* data)
   mac_ctrl_req_data_t* ctrl = (mac_ctrl_req_data_t*)data; 
   assert(ctrl->hdr.dummy == 1);
   assert(ctrl->msg.action == 42);
+  atomic_store(&mitigation_reads, 500);
 
   sm_ag_if_ans_t ans = {.type = CTRL_OUTCOME_SM_AG_IF_ANS_V0 };
   return ans;
